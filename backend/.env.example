# FinSight AI backend — copy to .env and fill in. Never commit .env.

# MongoDB Atlas (or local) connection
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net
DATABASE_NAME=finsight_ai

# JWT (use a random string of 32+ characters in production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Runtime
ENV=development            # production enables strict startup checks
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:5173","https://your-frontend.vercel.app"]

# Groq (LLM, vision, speech)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo

# Optional
RATE_LIMITS_ENABLED=true
DIGEST_CRON_SECRET=        # enables POST /api/ai/digests/run for a scheduler
# FINSIGHT_DISABLE_EMBEDDINGS=1   # force BM25-only retrieval
