# ──────────────────────────────────────────────
# FinSight AI — .gitignore
# ──────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.env
.env.*
!.env.example
pip-log.txt
pip-delete-this-directory.txt

# ── Node / Frontend ───────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Test & Coverage ───────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc
.tox/

# ── IDE & Editors ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Logs ──────────────────────────────────────
*.log
logs/

# ── Runtime / Temporary ───────────────────────
*.tmp
*.temp
*.bak

# ── Project-specific ──────────────────────────
# Charts regenerated by data_preparation.py
backend/data/charts/

# RAG embedding cache (rebuilt automatically on startup)
backend/data/.rag_cache/

# Local evaluation reports
backend/evals/results/
